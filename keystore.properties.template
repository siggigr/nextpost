# Template for keystore.properties (which is gitignored -- this template is not).
# Copy to keystore.properties in the project root and fill in real values.
#
# The release signing config in app/build.gradle.kts reads these four keys. If
# keystore.properties is absent, no release signing config is created and
# assembleRelease/bundleRelease fail with an explanatory message rather than
# quietly producing an unsigned APK.
#
# storeFile must be an ABSOLUTE path to a keystore kept OUTSIDE this repository.
# Use FORWARD slashes even on Windows: this is a Java .properties file, where a
# backslash is an escape character, so C:\Users\... would be silently mangled.

storeFile=C:/Users/siggi/keystores/nextpost-release.jks
storePassword=
keyAlias=nextpost
keyPassword=
