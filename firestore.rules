rules_version = '2';

// M3 scope: a creator's own draft games, posts and clues. Player-facing gating (gameCodes
// reads/creates, published-game reads, session reads/writes) is section 8's remaining scope
// and lands with M4/M5, added onto this file rather than replacing it — see section 8:
// "write the rules alongside the feature, not at the end." Deletion (section 5.1) is the one
// piece of published-game and gameCodes access added early, ahead of M4, because My games
// needs to delete a published game's whole tree in one operation regardless of milestone.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Single read of the parent game doc, bound to a local name so a rule that needs it
    // more than once (creatorUid, then status) doesn't pay for it twice.
    function isDraftOwner(gameId) {
      let game = get(/databases/$(database)/documents/games/$(gameId)).data;
      return isSignedIn() && game.creatorUid == request.auth.uid && game.status == 'draft';
    }

    // Ownership alone, regardless of status. Deletion (section 5.1) must work on a published
    // game too, not just a draft, so this is deliberately narrower than isDraftOwner only in
    // that it drops the status check — it must not be used for read/write of game content.
    function isGameOwner(gameId) {
      let game = get(/databases/$(database)/documents/games/$(gameId)).data;
      return isSignedIn() && game.creatorUid == request.auth.uid;
    }

    match /games/{gameId} {
      allow read: if isSignedIn() && resource.data.creatorUid == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.status == 'draft';

      // creatorUid and status can't move via a plain update: reassigning ownership or
      // flipping straight to "published" needs its own rule, added when M4 builds publish.
      allow update: if isSignedIn()
        && resource.data.creatorUid == request.auth.uid
        && resource.data.status == 'draft'
        && request.resource.data.creatorUid == resource.data.creatorUid
        && request.resource.data.status == 'draft';

      // Widened from draft-only per section 5.1: My games lets a creator delete a published
      // game, not just a draft, so status is no longer part of this check.
      allow delete: if isSignedIn() && resource.data.creatorUid == request.auth.uid;

      match /posts/{postId} {
        allow read, write: if isDraftOwner(gameId);
        // Deleting a published game's posts is part of the same walk-the-tree operation as
        // deleting the game document itself (see GameRepository.deleteGame), so this can't
        // be gated on draft status the way the read/write rule above is.
        allow delete: if isGameOwner(gameId);

        match /clues/{clueId} {
          allow read, write: if isDraftOwner(gameId);
          allow delete: if isGameOwner(gameId);
        }
      }

      match /sessions/{sessionId} {
        // Full read/write for players and the creator is section 8's remaining scope, landing
        // with M4/M5. Delete only, for now, so a game deletion can clear sessions too.
        allow delete: if isGameOwner(gameId);
      }
    }

    match /gameCodes/{code} {
      // Read (for joining) and create (for publishing) are M4 scope. Delete is needed now:
      // deleting a published game removes its code in the same operation, per section 5.1,
      // or the code stays resolvable and a joining player hits a game that no longer exists.
      allow delete: if isSignedIn()
        && get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.creatorUid == request.auth.uid;
    }
  }
}
